rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isStaff() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.isStaff == true;
    }

    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }

    // Staff Profiles
    match /staff/{staffId} {
      function isValidStaff(data) {
        return data.keys().hasAll(['uid', 'email', 'fullName', 'role', 'status']) &&
               data.uid == request.auth.uid &&
               data.email is string &&
               data.fullName is string &&
               data.role in ['staff', 'admin', 'hr'] &&
               data.status in ['pending', 'active', 'suspended'];
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidStaff(request.resource.data);
      allow update: if isSignedIn() && (
        request.auth.uid == staffId || isAdmin()
      ) && (
        // Self update of specific fields
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'biography', 'skills', 'specialization', 'qualifications', 'certifications'])) ||
        // Admin update
        isAdmin()
      );
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'hr');
    }

    // Staff Documents
    match /staff_docs/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'hr');
    }

    // CAC Metadata
    match /cac_metadata/{cacId} {
      function isValidCac(data) {
        return data.keys().hasAll(['company_name', 'registration_number', 'registration_date']) &&
               data.company_name is string && data.company_name.size() <= 200 &&
               data.registration_number is string && data.registration_number.size() <= 50 &&
               data.registration_date is string;
      }
      allow read: if true; // Publicly accessible
      allow write: if isAdmin();
    }

    // Page Content
    match /page_content/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
