{
  "entities": {
    "StaffMember": {
      "title": "Staff Member",
      "description": "A staff member's profile and authentication data.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The Firebase Auth UID." },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "jobTitle": { "type": "string" },
        "role": { "type": "string", "enum": ["staff", "admin", "hr"] },
        "departmentId": { "type": "string" },
        "gender": { "type": "string" },
        "dob": { "type": "string" },
        "nationality": { "type": "string" },
        "specialization": { "type": "string" },
        "biography": { "type": "string" },
        "skills": { "type": "string" },
        "qualifications": { "type": "string" },
        "certifications": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active", "suspended"] },
        "isStaff": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "role", "status"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Corporate announcements for staff.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "targetAudience": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "priority", "createdAt"]
    },
    "StaffDoc": {
      "title": "Staff Document",
      "description": "Internal documents and policies.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "mimeType": { "type": "string" },
        "targetRole": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "fileName", "createdAt"]
    },
    "CacMetadata": {
      "title": "CAC Metadata",
      "description": "Metadata for Corporate Affairs Commission certificates.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "company_name": { "type": "string" },
        "registration_number": { "type": "string" },
        "business_type": { "type": "string" },
        "registration_date": { "type": "string" },
        "company_status": { "type": "string" },
        "registered_address": { "type": "string" },
        "description": { "type": "string" },
        "verification_url": { "type": "string" },
        "r2_object_key": { "type": "string" },
        "file_name": { "type": "string" },
        "file_size": { "type": "number" },
        "mime_type": { "type": "string" },
        "is_published": { "type": "number" },
        "display_order": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["company_name", "registration_number", "registration_date"]
    },
    "ServiceItem": {
      "title": "Service Item",
      "description": "A service offered by the agency.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "url": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["name", "price", "category"]
    },
    "PortfolioProject": {
      "title": "Portfolio Project",
      "description": "A completed project showcase.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "client": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "stats": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "category", "image"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "An article or blog entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "content": { "type": "string" },
        "readTime": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string" }
      },
      "required": ["title", "category", "author", "content"]
    },
    "Course": {
      "title": "Course",
      "description": "A training course in the LMS.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "duration": { "type": "string" },
        "level": { "type": "string" },
        "price": { "type": "string" },
        "category": { "type": "string" },
        "lessons": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["title", "description", "category", "price"]
    },
    "ClientProject": {
      "title": "Client Project",
      "description": "A project assigned to a specific client.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "progress": { "type": "number" },
        "deadline": { "type": "string" },
        "clientName": { "type": "string" },
        "budget": { "type": "string" }
      },
      "required": ["name", "status", "clientName"]
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": "ServiceItem",
      "description": "Agency services catalog."
    },
    "/portfolio/{projectId}": {
      "schema": "PortfolioProject",
      "description": "Project portfolio showcase."
    },
    "/blogs/{blogId}": {
      "schema": "BlogPost",
      "description": "Blog articles."
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "LMS training courses."
    },
    "/client_projects/{projectId}": {
      "schema": "ClientProject",
      "description": "Individual client projects for the portal."
    },
    "/cac_metadata/{cacId}": {
      "schema": "CacMetadata",
      "description": "CAC certificates metadata."
    },
    "/staff/{staffId}": {
      "schema": "StaffMember",
      "description": "Staff profiles collection."
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Corporate announcements."
    },
    "/staff_docs/{docId}": {
      "schema": "StaffDoc",
      "description": "Internal documents."
    }
  }
}
